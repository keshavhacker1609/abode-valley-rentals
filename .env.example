# ── Brand & contact (shown across the site, JSON-LD and WhatsApp links) ──
NEXT_PUBLIC_BROKERAGE_NAME="VILEN Rentals"
NEXT_PUBLIC_SITE_URL="https://example.com"
# Main number/email for site-wide WhatsApp & Call buttons. Leave empty to use the broker marked
# "primary" in data/team.json (Ankit Anand Singh). Digits incl. country code, e.g. 917979895233
PHONE=""
EMAIL=""
ADDRESS="Shop 4, GST Road, Potheri, Kattankulathur, Chengalpattu 603203"
OFFICE_HOURS="Mon–Sat, 9:30am – 7:30pm"

# ── Maps ── Optional. Without a key the site uses OpenStreetMap (Leaflet) + keyless Google embed.
MAPS_KEY=""

# ── Admin ── Required to use /admin. Use a long random string.
ADMIN_PASS=""

# ── Persistence for admin edits ──
# Locally edits are written to data/overrides.json.
# On Vercel the filesystem is read-only: set these (Upstash Redis, free tier works).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Optional: Google Sheet as CMS ──
# Publish a sheet to the web as CSV (File → Share → Publish to web → CSV).
# Columns (header row): id,status,rent,deposit,maintenance,availableFrom,furnishing
SHEET_CSV_URL=""
# Seconds between sheet refreshes
SHEET_REVALIDATE="300"

# ── Optional: where enquiry / visit / owner forms are forwarded (Slack, Make, Zapier, Apps Script…) ──
ENQUIRY_WEBHOOK_URL=""
